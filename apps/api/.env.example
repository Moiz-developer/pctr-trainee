# Copy to .env and fill in real values for local development.
# .env is gitignored — never commit real credentials.

NODE_ENV=development
PORT=4000

# Comma-separated list of allowed browser origins. No wildcard in production.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Supabase PostgreSQL connection string (Session or Transaction pooler URL from your
# Supabase project's Database settings). Optional for now — required once any
# database-backed route is wired up. Privileged role (bypasses RLS) — used only by
# Prisma CLI tooling and lib/prisma-privileged.ts (seed scripts).
DATABASE_URL=

# RUNTIME_DATABASE_URL: REQUIRED as of Phase 2H — the API's actual runtime connection.
# Same pooler host as DATABASE_URL, but authenticating as the dedicated `app_api` role
# (NOBYPASSRLS, created by the enable_rls migration) instead of `postgres`. Pooler
# username convention: "app_api.<project-ref>" (mirrors "postgres.<project-ref>").
RUNTIME_DATABASE_URL=

# Supabase project credentials. SUPABASE_SERVICE_ROLE_KEY and SUPABASE_JWT_SECRET are
# server-only secrets: never prefix them with VITE_, never send them to the browser.

# SUPABASE_URL: REQUIRED — the API will not start without it. Used to fetch this
# project's JWKS endpoint (SUPABASE_URL + /auth/v1/.well-known/jwks.json) for verifying
# Supabase-issued JWTs (current Supabase projects sign with an asymmetric key by
# default, not a shared secret).
SUPABASE_URL=

# SUPABASE_SERVICE_ROLE_KEY: REQUIRED — the API will not start without it. Used only by
# lib/supabase-admin.ts to provision/update Supabase Auth users for
# POST/PATCH /api/v1/admin/users. Never sent to the browser, never logged.
SUPABASE_SERVICE_ROLE_KEY=

# SUPABASE_JWT_SECRET: optional — only consulted for tokens signed with the legacy
# shared-secret (HS256) algorithm. Not required for a project using JWKS/asymmetric
# signing (Project Settings -> API -> JWT Secret in the Supabase dashboard, if needed).
SUPABASE_JWT_SECRET=
