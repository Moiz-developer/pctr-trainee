# Copy to .env and fill in real values for local development.
# .env is gitignored — never commit real credentials.

NODE_ENV=development
PORT=4000

# Comma-separated list of allowed browser origins. No wildcard in production.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Supabase PostgreSQL connection string (Session or Transaction pooler URL from your
# Supabase project's Database settings). Optional for now — required once any
# database-backed route is wired up.
DATABASE_URL=

# Supabase project credentials. Optional for now — required starting in the Supabase
# integration step (Auth/Storage). SUPABASE_SERVICE_ROLE_KEY and SUPABASE_JWT_SECRET
# are server-only secrets: never prefix them with VITE_, never send them to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
