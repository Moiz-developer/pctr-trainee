# Copy to .env and fill in real values for local development.
# .env is gitignored — never commit real credentials.
#
# Only variables prefixed with VITE_ are readable by browser code, and everything in
# this file is bundled into the client. Never put DATABASE_URL, SUPABASE_SERVICE_ROLE_KEY,
# or SUPABASE_JWT_SECRET here — those are server-only and live in apps/api/.env.

# Supabase project's public URL and anon (publishable) key. Safe for the browser.
# Optional for now — required starting in the Supabase Auth integration step.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Base URL of the Node/Express API. No API client exists yet this step.
VITE_API_BASE_URL=http://localhost:4000
