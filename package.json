{
  "name": "internal-training-platform",
  "private": true,
  "version": "0.0.0",
  "description": "Internal Training Platform — monorepo root",
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "pnpm -r run typecheck",
    "build": "pnpm -r run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prisma:generate": "pnpm --filter @internal-training/api run prisma:generate",
    "prisma:validate": "pnpm --filter @internal-training/api run prisma:validate",
    "prisma:migrate": "pnpm --filter @internal-training/api run prisma:migrate",
    "prisma:studio": "pnpm --filter @internal-training/api run prisma:studio"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.70.0"
  }
}
